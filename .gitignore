# Environment Configuration
.env

# Uploads & User Media (preserve folder structure via .gitkeep)
/public/uploads/avatars/*
!/public/uploads/avatars/.gitkeep

# Cache & Storage
/storage/cache/*
!/storage/cache/.gitkeep

# Temporary & Scratch Files
/scratch/
*.cache
*.log

# System & OS Files
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini

# IDE & Editor Files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
