# GembokX Environment Configuration
APP_NAME="GembokX"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/pwd
APP_KEY=  # Generate with 64 hex characters (e.g. 32 bytes random)

# Database Settings (XAMPP default: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=passvault_db
DB_USER=root
DB_PASS=
DB_ROOT_PASS=root_secret_change_me

# Session Lifetime (Menit)
SESSION_LIFETIME=120

# Keamanan Tambahan
FORCE_HTTPS=false

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX="gembokx:"

