# GembokX Environment Configuration
APP_NAME="GembokX"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost/pwd

# Database Settings (XAMPP default: root tanpa password)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=passvault_db
DB_USER=root
DB_PASS=

# Session Lifetime (Menit)
SESSION_LIFETIME=120

# Keamanan Tambahan
FORCE_HTTPS=false

# Redis Cache Settings
REDIS_ENABLED=true
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_PREFIX="gembokx:"
